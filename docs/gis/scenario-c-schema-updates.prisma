// --- Tier 1 lookup models ---

model LookupEcdCenterStatus {
  id        String      @id @default(uuid())
  code      String      @unique
  labelEn   String      @map("label_en")
  sortOrder Int         @default(0) @map("sort_order")
  centers   EcdCenter[] @relation("CenterStatusLookup")

  @@map("lookup_ecd_center_status")
}

model LookupComplianceClassification {
  id                 String                 @id @default(uuid())
  code               String                 @unique
  labelEn            String                 @map("label_en")
  sortOrder          Int                    @default(0) @map("sort_order")
  centersCurrentLevel EcdCenter[]           @relation("CenterCurrentComplianceLevel")
  assessmentsOverall ComplianceAssessment[] @relation("AssessmentOverallClassification")

  @@map("lookup_compliance_classification")
}

