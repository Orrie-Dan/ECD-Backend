// --- STED normalized tables (Phase 5) ---

model StedMilestoneResult {
  id            String         @id @default(uuid())
  assessmentId  String         @map("assessment_id")
  assessment    StedAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  milestoneCode String         @map("milestone_code")
  resultKind    String         @map("result_kind")
  notes         String?
  createdAt     DateTime       @default(now()) @map("created_at")

  @@map("sted_milestone_result")
}

model StedPhysicalFinding {
  id           String         @id @default(uuid())
  assessmentId String         @map("assessment_id")
  assessment   StedAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  findingCode  String?        @map("finding_code")
  findingKind  String         @map("finding_kind")
  severity     String?
  createdAt    DateTime       @default(now()) @map("created_at")

  @@map("sted_physical_finding")
}

model StedOutcomeSummary {
  id                  String         @id @default(uuid())
  assessmentId        String         @unique @map("assessment_id")
  assessment          StedAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  referralRequired    Boolean        @default(false) @map("referral_required")
  hasPhysicalProblems Boolean        @default(false) @map("has_physical_problems")
  hasFailedMilestones Boolean        @default(false) @map("has_failed_milestones")
  outcomeCode         String?        @map("outcome_code")
  delayLevel          String?        @map("delay_level")
  createdAt           DateTime       @default(now()) @map("created_at")

  @@map("sted_outcome_summary")
}

