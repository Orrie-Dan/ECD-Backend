    "prisma:studio": "prisma studio",
    "test:sync-auth": "ts-node src/modules/sync/__tests__/sync-write-auth.spec.ts",
    "test:sync-idempotency": "ts-node src/modules/sync/__tests__/sync-push-idempotency.spec.ts",
    "test:sync-pull": "ts-node src/modules/sync/__tests__/sync-pull-pagination.spec.ts",
    "test:sync-recovery": "ts-node src/modules/sync/__tests__/sync-recovery.spec.ts",
    "test:sync-redis": "ts-node src/modules/sync/__tests__/redis.connection.spec.ts",
    "test:sync-apply-attendance": "ts-node src/modules/sync/__tests__/sync-apply-attendance.spec.ts",
    "test:sync-apply-feeding": "ts-node src/modules/sync/__tests__/sync-apply-feeding.spec.ts",
    "test:sync": "npm run test:sync-auth && npm run test:sync-idempotency && npm run test:sync-pull && npm run test:sync-recovery && npm run test:sync-redis && npm run test:sync-apply-attendance && npm run test:sync-apply-feeding",
    "test:sprint-3.4": "npm run test:sync && npm run test:sync-idempotency",
    "test:transfers": "ts-node src/modules/transfers/__tests__/transfer-lifecycle.spec.ts",
    "test:children": "ts-node src/modules/children/__tests__/child-mapper.spec.ts && ts-node src/modules/children/__tests__/children.optimistic-lock.spec.ts",
    "test:optimistic-lock": "ts-node src/modules/children/__tests__/children.optimistic-lock.spec.ts",
    "test:nutrition": "ts-node src/modules/nutrition/__tests__/nutrition.mapper.spec.ts && ts-node src/modules/nutrition/__tests__/nutrition.service.spec.ts && ts-node src/modules/nutrition/__tests__/nutrition.sync.spec.ts",
    "test:feeding": "ts-node src/modules/feeding/__tests__/feeding.mapper.spec.ts && ts-node src/modules/feeding/__tests__/feeding.service.spec.ts && ts-node src/modules/feeding/__tests__/feeding.sync.spec.ts",
    "test:users": "ts-node src/modules/users/tests/user.mapper.spec.ts && ts-node src/modules/users/tests/user.authorization.spec.ts && ts-node src/modules/users/tests/user.service.spec.ts",
    "test:attendance": "ts-node src/modules/attendance/__tests__/attendance.mapper.spec.ts && ts-node src/modules/attendance/__tests__/attendance.service.spec.ts && ts-node src/modules/attendance/__tests__/attendance.sync.spec.ts",
    "test:sted": "ts-node src/modules/sted/__tests__/sted.mapper.spec.ts && ts-node src/modules/sted/__tests__/sted.service.spec.ts && ts-node src/modules/sted/__tests__/sted.sync.spec.ts",
    "test:referrals": "ts-node src/modules/referrals/__tests__/referral.mapper.spec.ts && ts-node src/modules/referrals/__tests__/referral.service.spec.ts && ts-node src/modules/referrals/__tests__/referral.sync.spec.ts",
    "test:audit": "ts-node src/common/audit/__tests__/audit.service.spec.ts",
    "test:centers": "ts-node src/modules/centers/__tests__/centers.service.spec.ts",
    "test:analytics": "ts-node src/modules/analytics/__tests__/analytics.service.spec.ts",
    "test:alerts": "ts-node src/modules/alerts/__tests__/alerts.service.spec.ts",
    "test:notifications": "ts-node src/modules/notifications/__tests__/notification-cron.service.spec.ts",
    "test:monitoring": "ts-node src/modules/monitoring/__tests__/monitoring.service.spec.ts",
    "test:reports": "ts-node src/modules/reports/__tests__/reports.service.spec.ts",
    "test:audit-logs": "ts-node src/modules/audit-logs/__tests__/audit-logs.service.spec.ts",
    "test:settings": "ts-node src/modules/settings/__tests__/settings.service.spec.ts",
    "test:geo": "ts-node src/modules/geo/__tests__/geo.service.spec.ts",
    "test:compliance": "ts-node src/modules/compliance/__tests__/compliance.service.spec.ts",
    "test:wash": "ts-node src/modules/wash/__tests__/wash.service.spec.ts",
    "test:center-register": "ts-node src/modules/center-register/__tests__/center-register.service.spec.ts",
    "test:sprint-4.1": "npm run test:centers && npm run test:analytics && npm run test:alerts && npm run test:notifications && npm run test:sync-idempotency && npm run test:optimistic-lock && npm run test:audit",
    "test:sprint-4.2": "npm run test:monitoring && npm run test:reports && npm run test:audit-logs && npm run test:settings && npm run test:geo && npm run test:compliance && npm run test:wash && npm run test:center-register && npm run test:centers && npm run test:analytics && npm run test:alerts && npm run test:notifications && npm run test:sync-idempotency && npm run test:optimistic-lock && npm run test:audit",
    "test:sprint-3.2": "npm run test:optimistic-lock && npm run test:attendance && npm run test:referrals && npm run test:feeding && npm run test:transfers && npm run test:sync-idempotency",
    "test:sprint-3.3": "npm run test:audit && npm run test:children && npm run test:attendance && npm run test:transfers && npm run test:referrals && npm run test:feeding && npm run test:nutrition && npm run test:sted && npm run test:sync-idempotency",
    "seed:admin": "ts-node prisma/seed.ts",
    "report:orphaned-transfers": "ts-node scripts/report-orphaned-child-transfers.ts",
    "migrate:assign-classrooms": "ts-node scripts/assign-classrooms.ts",
    "migrate:national-ids": "ts-node scripts/migrate-national-ids.ts",
    "restore:backup-data": "ts-node scripts/restore-backup-data.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "engines": {
    "node": ">=20"
  },
