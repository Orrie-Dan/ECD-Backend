# ArcGIS Portal (GIS map embed BFF)
ARCGIS_PORTAL_URL=https://infrastructure.space.gov.rw/portal
ARCGIS_USERNAME=
ARCGIS_PASSWORD=
# Referer bound into Portal tokens (required for federated /server/rest layers)
ARCGIS_TOKEN_REFERER=https://infrastructure.space.gov.rw
# Comma-separated hostnames allowed through /api/v1/gis/proxy
ARCGIS_ALLOWED_HOSTS=infrastructure.space.gov.rw
# Portal token lifetime in minutes (default 60)
ARCGIS_TOKEN_EXPIRATION_MINUTES=60
