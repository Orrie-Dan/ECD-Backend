  updatedBy UserAccount? @relation("AppSettingUpdatedBy", fields: [updatedById], references: [id])

  @@unique([districtId, key])
  @@map("app_setting")
}

model AuditLog {
  id          String      @id @default(uuid())
  entityType  String      @map("entity_type")
  entityId    String      @map("entity_id")
  action      AuditAction
  changedById String?     @map("changed_by")
  changedAt   DateTime    @default(now()) @map("changed_at")
  oldValues   Json?       @map("old_values")
  newValues   Json?       @map("new_values")
  /// Attribution + domain action: { domainAction, actorType, deviceId?, operationId?, ... }
  metadata    Json?

  changedBy UserAccount? @relation("AuditLogChangedBy", fields: [changedById], references: [id])

  @@index([entityType, entityId])
  @@index([changedAt])
  @@map("audit_log")
}
